# Copia este archivo a .env y completa con tu proyecto de Supabase
# (Dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública de la versión web. Se usa en los enlaces que se comparten.
EXPO_PUBLIC_WEB_URL=

# Opcionales. Sin estas variables la app no envía nada a ningún servicio externo.
# Reporte de errores de JavaScript a Sentry (DSN del proyecto, es público por diseño).
EXPO_PUBLIC_SENTRY_DSN=
# Eventos de producto a PostHog (clave pública del proyecto y host de la región).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
